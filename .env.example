# =============================================================================
# agentmemory configuration
# =============================================================================
#
# Copy this file to `~/.agentmemory/.env` (or to your project root if you
# prefer scoped config) and uncomment the lines you want to override.
#
# Every line is OFF by default — `agentmemory` runs out of the box with no
# LLM key, no embedding key, and no API auth. Set keys here only when you
# want to enable the corresponding feature.
#
# Run `npx @agentmemory/agentmemory init` to copy this file into place
# automatically. Run `npx @agentmemory/agentmemory doctor` to verify that
# the daemon reads the env you expect.
#
# Defaults shown in comments. Listed in priority order — the first key
# present wins on the LLM detection path (see src/config.ts::detectProvider).

# -----------------------------------------------------------------------------
# 1. LLM provider — pick ONE
# -----------------------------------------------------------------------------
#
# Without a provider key, agentmemory runs in noop mode: observations are
# indexed via zero-LLM synthetic compression, hybrid search still works,
# but LLM-backed summarisation / reflection / consolidation are disabled.
# The detection order is OPENAI_API_KEY → MINIMAX_API_KEY → ANTHROPIC_API_KEY
# → GEMINI_API_KEY → OPENROUTER_API_KEY → AGENTMEMORY_CODEX →
# AGENTMEMORY_ALLOW_AGENT_SDK → noop.

# OPENAI_API_KEY=sk-...                          # Used for BOTH chat completions and embeddings. Works with any OpenAI-compatible endpoint (DeepSeek, SiliconFlow, vLLM, LM Studio, Ollama via `/v1`) — point OPENAI_BASE_URL at it.
# OPENAI_BASE_URL=https://api.openai.com         # Override for OpenAI-compatible providers
# OPENAI_MODEL=gpt-4o-mini                       # Chat model (src/providers/openai.ts). Default: gpt-4o-mini
# OPENAI_TIMEOUT_MS=60000                        # OpenAI-scoped alias of AGENTMEMORY_LLM_TIMEOUT_MS; takes precedence on the OpenAI path
# OPENAI_REASONING_EFFORT=minimal                # Passed through for reasoning models; unset by default
# OPENAI_API_VERSION=                            # Azure OpenAI api-version, when pointing at an Azure deployment

# Detach chat from embeddings. Set to `false` to keep OPENAI_API_KEY for
# EMBEDDINGS ONLY and let the LLM detection chain fall through to the next
# provider (src/config.ts::detectProvider — the guard is
# `OPENAI_API_KEY_FOR_LLM !== "false"`, so any other value, including unset,
# means "use it for chat too").
#
# This is what you want when the OpenAI-compatible endpoint you use for chat
# is NOT the one you want for embeddings — e.g. chat on DeepSeek, embeddings on
# OpenAI — or when you want the Codex / agent-SDK subscription branch to win
# while an embedding key stays configured.
# OPENAI_API_KEY_FOR_LLM=false

# Separate credentials for the embedding leg. Both fall back to the chat pair
# above when unset, so set them only when the two endpoints differ.
# OPENAI_EMBEDDING_API_KEY=sk-...                # Falls back to OPENAI_API_KEY
# OPENAI_EMBEDDING_BASE_URL=https://api.openai.com  # Falls back to OPENAI_BASE_URL
#
# ⚠️ A wrong embedding key does NOT fail loudly: the vector index silently stops
# updating and hybrid search degrades to BM25 alone. Verify with a query whose
# hits are semantic rather than lexical — if `/smart-search` and `/search`
# return the same set, the vector leg is dead.

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514       # Default Anthropic model
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # Override for Anthropic-compatible proxies / Azure AI Foundry

# GEMINI_API_KEY=...                             # Either env name works; GEMINI_API_KEY takes precedence
# GOOGLE_API_KEY=...                             # Alias for GEMINI_API_KEY when set alone (emits a one-time stderr hint)
# GEMINI_MODEL=gemini-2.5-flash                  # Default Gemini model (auto-detected GA model)

# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514

# MINIMAX_API_KEY=...
# MINIMAX_MODEL=MiniMax-M2.7

# MAX_TOKENS=4096                                # Cap LLM completion tokens for compression / summarise calls

# Outbound LLM / embedding timeout — shared across every raw-fetch provider
# (Gemini, OpenRouter, MiniMax, OpenAI LLM, and OpenAI/Cohere/Voyage/OpenRouter
# embedding). The OpenAI LLM path also honours the OpenAI-scoped
# OPENAI_TIMEOUT_MS alias for back-compat with v0.9.17 (precedence).
# AGENTMEMORY_LLM_TIMEOUT_MS=60000                # Default: 60 000 ms (60 s)

# Opt-in ChatGPT-subscription provider (spawns `codex exec` child processes via
# @openai/codex-sdk). Off by default, and it never overrides a configured API
# key: the branch sits below every keyed provider above and above
# AGENTMEMORY_ALLOW_AGENT_SDK, so when BOTH key-less flags are set, codex wins.
#
# Requires an active Codex / ChatGPT session. See "Authorising Codex" below for
# how to create one and how to check it — the check is local and instant.
#
# Without a session, a call fails as HTTP 401 from api.openai.com
# ("Missing bearer or basic authentication in header") after roughly 28 seconds.
# That is FOUR TIMES slower than a successful call, so an unauthorised daemon
# does not look broken — it looks slow. Check the session before enabling.
#
# Latency is higher than the API providers and that is expected, not a failure.
# Measured on real prompts: compress-shaped 27 372 ms, summarize-shaped
# 21 757 ms, against 12 902 ms for DeepSeek on compress — i.e. compress is about
# twice as slow.
#
# READ BEFORE ENABLING — what the child process can do. The SDK spawns
# `codex exec`, and that process:
#   * runs shell commands as the daemon's uid;
#   * under sandboxMode "read-only" can READ ANY FILE that uid can read —
#     "read-only" restricts writes, not reads, by design (SDK docs: "Read files
#     without allowing writes");
#   * sees the MCP servers registered in your own ~/.codex/config.toml
#     (agentmemory's own server is disabled per call, the others are not).
# The observation text that goes into the compression prompt is untrusted: it is
# tool output, file contents and fetched web pages. Whatever the child reads
# comes back as a "compressed observation" and is stored in memory. No other
# agentmemory provider has this capability. Enable it as a deliberate choice.
#
# AGENTMEMORY_CODEX=true
# AGENTMEMORY_CODEX_MODEL=                       # Unset → Codex picks the model from your ~/.codex/config.toml; any value set here is passed to Codex as-is
# AGENTMEMORY_CODEX_REASONING_EFFORT=            # Unset → Codex picks the default effort for the selected model; allowed values depend on the model — list them with `agentmemory codex effort`
# AGENTMEMORY_CODEX_TIMEOUT_MS=90000             # Default: 90 000 ms (90 s) per call
# AGENTMEMORY_CODEX_MAX_CONCURRENCY=1            # Default: 1 — cap on simultaneous `codex exec` children

# -----------------------------------------------------------------------------
# 1a. Authorising Codex
# -----------------------------------------------------------------------------
#
# AGENTMEMORY_CODEX=true is only half the setup. The child process authenticates
# with a Codex/ChatGPT session stored on disk — agentmemory never sees, stores
# or forwards your credentials, and there is no API key involved on this path.
#
# WHERE THE SESSION LIVES
#
#   $CODEX_HOME, defaulting to ~/.codex
#
# One session serves both a system-wide `codex` and the copy bundled with
# agentmemory — they read the same directory. Logging in once is enough; you do
# NOT need to install Codex separately just for agentmemory.
#
#   ⚠️ The daemon reads the HOME it was started with. Under the macOS
#   LaunchAgent that is the HOME set in the plist. If you log in as a different
#   user, or the daemon runs with a different HOME, the session is invisible to
#   it even though `codex login status` succeeds in your shell.
#
# CHECK FIRST AND SIGN IN — via agentmemory's own CLI, not a hand-rolled
# recipe: it resolves the SAME `@openai/codex` binary the daemon runs (no PATH
# lookup, so it cannot point at a different install than the daemon uses),
# checks locally, and touches no network:
#
#   agentmemory codex status   # session + AGENTMEMORY_CODEX (file vs. running daemon) + model + effort
#     → exit 0  logged in
#     → exit 1  not logged in
#     → exit 3  could not check (binary missing, etc.)
#   agentmemory codex login    # opens a browser, sign in with your ChatGPT account
#   agentmemory codex logout
#
# `status` answers in well under a second — it decides by the child's EXIT
# CODE, never by reading its output, so it is immune to a reworded or
# localised status line and never sees your credentials. `~/.codex/auth.json`
# is never opened by agentmemory.
#
# Model and reasoning effort are steered the same way, validated against
# Codex's own model catalogue (not a hard-coded list):
#
#   agentmemory codex model            # list models Codex offers, current one marked
#   agentmemory codex model <name>     # pin AGENTMEMORY_CODEX_MODEL
#   agentmemory codex effort           # list efforts the CURRENT model supports
#   agentmemory codex effort <level>   # pin AGENTMEMORY_CODEX_REASONING_EFFORT
#
# AFTER ENABLING — what a working provider looks like
#
#   grep '"compress":"llm"' ~/.agentmemory/logs/daemon.err.log
#
# Before the switch every observation is compressed synthetically; afterwards
# `"compress":"llm"` starts appearing. Expect a LOW ratio of llm to synthetic:
# at ~27 s per call and a concurrency cap of 1 the provider handles roughly two
# observations per minute while they arrive faster. That is throughput, not
# failure — judge the provider by the failure count, never by the ratio or the
# latency, or you will roll back a working install.
#
# ⚠️ Do not set AGENTMEMORY_CODEX=true together with a chat-capable
# OPENAI_API_KEY unless you also set OPENAI_API_KEY_FOR_LLM=false — the keyed
# branch is checked first and wins, and the Codex branch is never reached.

# Opt-in Claude-subscription fallback (spawns @anthropic-ai/claude-agent-sdk
# child sessions). Off by default — the agent-sdk fallback can trigger
# Stop-hook recursion (#149 follow-up) when invoked from inside Claude Code.
# AGENTMEMORY_ALLOW_AGENT_SDK=true

# FALLBACK_PROVIDERS=anthropic,gemini            # Comma-separated chain tried after the primary provider returns an error (e.g. rate limit)

# -----------------------------------------------------------------------------
# 2. Embedding provider — auto-detected, override via EMBEDDING_PROVIDER
# -----------------------------------------------------------------------------
#
# Without an embedding key, agentmemory runs in BM25-only mode for hybrid
# search. Detection order: EMBEDDING_PROVIDER override → GEMINI_API_KEY →
# OPENAI_API_KEY → VOYAGE_API_KEY → COHERE_API_KEY → OPENROUTER_API_KEY →
# local (Xenova/all-MiniLM-L6-v2, 384-dim).

# EMBEDDING_PROVIDER=local                       # local | openai | voyage | cohere | gemini | openrouter

# VOYAGE_API_KEY=pa-...                          # Optimised for code embeddings

# COHERE_API_KEY=...                             # General-purpose embeddings

# Reuses OPENAI_API_KEY / OPENAI_BASE_URL above when EMBEDDING_PROVIDER=openai.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # Embedding model when EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_DIMENSIONS=1536               # Required when the model is not in the known-models table

# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small  # When EMBEDDING_PROVIDER=openrouter

# -----------------------------------------------------------------------------
# 3. Auth & security
# -----------------------------------------------------------------------------
#
# Bearer-token auth for the REST API + viewer + all integration plugins.
# Without a secret, REST endpoints are open on loopback. Set this when
# you expose the daemon beyond loopback or run behind a reverse proxy.

# AGENTMEMORY_SECRET=your-secret-here

# -----------------------------------------------------------------------------
# 4. Search tuning
# -----------------------------------------------------------------------------

# BM25_WEIGHT=0.4                                # Hybrid search weight for BM25 leg
# VECTOR_WEIGHT=0.6                              # Hybrid search weight for vector leg
# AGENTMEMORY_GRAPH_WEIGHT=0.2                   # Graph traversal bonus on smart-search ranking
# TOKEN_BUDGET=2000                              # Max tokens injected via mem::context per session
# MAX_OBS_PER_SESSION=500                        # Per-session observation cap before consolidation kicks in
# SUMMARIZE_CHUNK_SIZE=400                       # When mem::summarize sees a session larger than this, it chunks observations and map-reduces (chunk-summarize → reduce-merge) to stay within the LLM's context window. Default 400 ≈ 50k tokens per chunk at ~110 tok/obs. Native sessions are capped by MAX_OBS_PER_SESSION; chunking primarily matters for bulk-imported jsonl sessions, which bypass that cap.
# SUMMARIZE_CHUNK_CONCURRENCY=6                  # Parallel chunk LLM calls during chunked summarize. Default 6 fits ~100-chunk sessions under iii's 180s function-invocation timeout at typical ~8s/call. High-throughput providers (Novita, DeepInfra, DeepSeek) commonly allow 100+ concurrent — bump this for very large imported sessions.

# -----------------------------------------------------------------------------
# 5. Behaviour flags
# -----------------------------------------------------------------------------

# AGENTMEMORY_AUTO_COMPRESS=true                 # Run LLM compression on every observation batch (requires a provider key). Default off — synthetic compression handles most cases.
# AGENTMEMORY_INJECT_CONTEXT=true                # Inject recalled memories back into agent prompts (#143). Default off — hooks capture observations but do not modify conversation.
# CONSOLIDATION_ENABLED=true                     # Run the 4-tier consolidation pipeline (memories → semantic → procedural). Default off — opt in once you've measured the LLM cost.
# CONSOLIDATION_DECAY_DAYS=30                    # Age (days) after which non-reinforced memories decay during consolidation
# GRAPH_EXTRACTION_ENABLED=true                  # Extract concept-graph edges on remember; powers the graph-traversal recall path
# GRAPH_EXTRACTION_BATCH_SIZE=8                  # Memories per graph-extraction batch
# AGENTMEMORY_REFLECT=true                       # Periodically auto-synthesize lessons from memories
# AGENTMEMORY_DROP_STALE_INDEX=true              # Drop on-disk BM25 / vector index on startup if dim guard fires (#248). Recovery toggle for stuck-state debugging.
# AGENTMEMORY_IMAGE_EMBEDDINGS=true              # Enable image embeddings when an image provider is present (experimental).

# -----------------------------------------------------------------------------
# 5a. Retention & store maintenance
# -----------------------------------------------------------------------------
#
# These run on boot timers inside the worker. They delete data, so read the
# defaults before changing them.

# Eviction sweep — applies the retention policy (stale sessions, per-project
# observation cap) and prunes the BM25 + vector indexes on every delete path.
# ON by default: the guard is `EVICT_ENABLED !== "false"` (src/index.ts:649),
# so only the literal string `false` turns it off.
# EVICT_ENABLED=false                            # Default: enabled
# EVICT_INTERVAL_MS=86400000                     # Default: 86 400 000 ms (24 h), src/index.ts:589

# Orphaned index generations — shard sets left behind when the worker dies
# mid-write. One violent restart can strand tens of MB, and they are never
# reclaimed otherwise.
#   dry (default) — count and log only
#   on            — delete them at startup
# Start with `dry`, read the reported candidate count and size, then switch.
# AGENTMEMORY_INDEX_ORPHAN_SWEEP=on              # Default: dry

# AUTO_FORGET_ENABLED=true                       # Age-based forgetting pass
# AUTO_FORGET_INTERVAL_MS=                       # Interval for the pass above
# CONSOLIDATION_INTERVAL_MS=                     # Interval for the consolidation pipeline (see CONSOLIDATION_ENABLED)
# LESSON_DECAY_ENABLED=true                      # Decay confidence of unused lessons
# INSIGHT_DECAY_ENABLED=true                     # Decay confidence of unused insights

# -----------------------------------------------------------------------------
# 6. CLI / runtime knobs
# -----------------------------------------------------------------------------

# AGENTMEMORY_VERBOSE=1                          # Boot diagnostics to stderr. Accepts "1" or "true". Without it `bootLog` messages are not written AT ALL — several startup facts (timer registration, sweep results) are invisible in the default quiet mode, so set this before concluding that something did not run.
# AGENTMEMORY_DATA_DIR=~/.agentmemory            # Override the data directory. NOTE: not honoured by every code path in 0.9.29 — the engine still resolves its store relative to the daemon's working directory, so pin WorkingDirectory in your service unit rather than relying on this alone.
# AGENTMEMORY_III_CONFIG=                        # Path to an alternative iii-config.yaml
# AGENTMEMORY_USE_DOCKER=1                       # Run the iii engine via docker compose instead of the host binary
# RERANK_ENABLED=true                            # Cross-encoder rerank pass over hybrid search results
# AGENTMEMORY_SUPPRESS_COST_WARNING=1            # Silence the one-time LLM cost notice

# AGENTMEMORY_TOOLS=all                          # core (7 tools, default) | all (51 tools) — surface exposed to MCP clients
# AGENTMEMORY_SLOTS=memory                       # Comma-separated plugin slot names the CLI should claim
# AGENTMEMORY_DEBUG=1                            # Trace MCP shim probe + standalone fallback decisions to stderr
# AGENTMEMORY_FORCE_PROXY=1                      # Skip the MCP shim livez probe and trust AGENTMEMORY_URL (for sandboxed MCP clients that can't reach localhost)
# AGENTMEMORY_PROBE_TIMEOUT_MS=2000              # MCP shim livez probe timeout
# AGENTMEMORY_URL=http://localhost:3111          # REST base URL — honored by status, doctor, MCP shim
# AGENTMEMORY_VIEWER_URL=http://localhost:3113   # Override the viewer URL printed by `agentmemory status`
# AGENTMEMORY_EXPORT_ROOT=~/agentmemory-backup   # Default destination for `agentmemory export`

# STANDALONE_MCP=1                               # MCP shim only — bypass the worker and run @agentmemory/mcp in-process
# STANDALONE_PERSIST_PATH=~/.agentmemory/local.db  # Path used by the standalone MCP shim's local fallback store

# Snapshot exporter — periodic snapshots of state_store + stream_store.
# SNAPSHOT_ENABLED=true
# SNAPSHOT_DIR=~/.agentmemory/snapshots
# SNAPSHOT_INTERVAL=3600                         # Seconds between snapshots

# Team sharing — when set, memories are scoped to (TEAM_ID, USER_ID) tuples.
# TEAM_MODE=shared
# TEAM_ID=acme
# USER_ID=rohit

# -----------------------------------------------------------------------------
# 7. Ports
# -----------------------------------------------------------------------------

# III_REST_PORT=3111                             # REST API port (also affects viewer at +2)
# III_STREAMS_PORT=3112                          # Streams API port
# III_ENGINE_URL=ws://localhost:49134            # iii-engine WebSocket URL (used by the worker)

# -----------------------------------------------------------------------------
# 8. iii engine pin
# -----------------------------------------------------------------------------
#
# agentmemory currently pins iii-engine to v0.11.2 — v0.11.6 introduces a
# new sandbox-everything-via-`iii worker add` model that agentmemory
# hasn't been refactored for yet. Override with AGENTMEMORY_III_VERSION
# only after migrating to the sandbox model manually.

# AGENTMEMORY_III_VERSION=0.11.2

# -----------------------------------------------------------------------------
# 9. Claude Code bridge (opt-in)
# -----------------------------------------------------------------------------

# CLAUDE_MEMORY_BRIDGE=true                      # Mirror compressed memories into Claude Code's CLAUDE.md
# CLAUDE_PROJECT_PATH=/path/to/your/project      # Required when CLAUDE_MEMORY_BRIDGE=true
# CLAUDE_MEMORY_LINE_BUDGET=200                  # Lines of memory CLAUDE.md should hold

# -----------------------------------------------------------------------------
# 10. Obsidian export (opt-in)
# -----------------------------------------------------------------------------

# OBSIDIAN_AUTO_EXPORT=true                      # Auto-export memories to an Obsidian vault on every consolidation
